# Environment template for the Retail Analytics project.
# Copy this file to `.env` and replace the placeholder values.
# Never commit a real `.env` file (it is gitignored).

# PostgreSQL connection string for the SQL analytics layer (sql/) and the
# Phase 5 pipeline stages 04-09 (PostgreSQL load, SQL analytics, Power BI
# dataset, validation). Required.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/retail_analysis

# Raw source dataset used by the cleaning stage.
# Default: <repo>/online_retail.csv
# INPUT_DATA_PATH=C:\Users\Abdul Rehman\Documents\GitHub\Maimoona Data Analysis\online_retail.csv

# Directory for pipeline run manifests, reports and logs.
# Default: <repo>/reports
# OUTPUT_DIR=C:\Users\Abdul Rehman\Documents\GitHub\Maimoona Data Analysis\reports

# Root directory for heavy/temporary pipeline processing (notebook scratch,
# temp workbooks, test workspaces, Power BI exports). Point this at a large
# drive (e.g. D:) so temporary work never fills the drive holding the repo.
# Default: <system temp>/RetailAnalytics_Temp
# PIPELINE_TEMP_DIR=D:\RetailAnalytics_Temp
